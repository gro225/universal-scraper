# Скопировать в .env перед запуском: cp .env.example .env

DATABASE_URL=postgresql://harvester:harvester@localhost:5432/harvester
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT=http://localhost:9000
# Адрес хранилища для браузера; в compose api ходит в minio:9000,
# а presigned-ссылку нужно подписывать под внешний хост
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=harvester

MEILI_URL=http://localhost:7700
MEILI_KEY=harvester-dev-key

SEARXNG_URL=http://localhost:8888

# Идентифицируйте себя честно и оставьте рабочий контакт — этого ждут админы сайтов
USER_AGENT=UniversalHarvester/0.1 (+research crawler; contact: you@example.com)

FETCH_TIMEOUT_S=20
MAX_RESPONSE_BYTES=8388608
MAX_MEDIA_BYTES=26214400
CRAWL_WORKERS=8
MEDIA_WORKERS=4

# --- тир T1: рендер в браузере (crawl4ai) ---
# Включать после: pip install -e '.[render]' && crawl4ai-setup
RENDER_ENABLED=false
RENDER_CONCURRENCY=3
RENDER_TIMEOUT_S=45
# Меньше этого объёма видимого текста -> страница считается недорендеренной
RENDER_MIN_TEXT_CHARS=500
# domcontentloaded — быстро; networkidle — надёжнее для ленивых SPA, но дороже
RENDER_WAIT_UNTIL=domcontentloaded
RENDER_WAIT_MS=0
RENDER_SCROLL=false
# Пробовать браузер на 403/429. Обычно не помогает: против антибота нужен stealth
RENDER_ON_BLOCK=false
